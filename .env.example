PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:5173

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=goldfinch-media
# Cloudflare R2 (backend-only credentials). Leave R2_ENABLED=false for the
# existing Supabase Storage path. R2_PUBLIC_URL is your public custom domain or
# r2.dev URL, without a trailing slash.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=goldfinch-media
R2_PUBLIC_URL=https://media.example.com
# Oversized originals are reduced before upload; responsive variants still use
# the ladder configured in upload.service.ts.
MEDIA_MAX_ORIGINAL_WIDTH=2400
MEDIA_ORIGINAL_QUALITY=82
# Raw Postgres connection string from Supabase Project Settings → Database.
# Used only by `npm run db:pipeline` to apply schema, migrations, and seed SQL.
SUPABASE_DB_URL=

JWT_SECRET=change-this-to-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=7d

ANTHROPIC_API_KEY=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# Exchange rates (Open Exchange Rates) — backend only. Never expose App ID in frontend env.
OPEN_EXCHANGE_RATES_APP_ID=
EXCHANGE_RATE_REFRESH_ENABLED=true
EXCHANGE_RATE_REFRESH_CRON=0 6,18 * * *
EXCHANGE_RATE_TIMEZONE=Africa/Dar_es_Salaam
EXCHANGE_RATE_CACHE_HOURS=12
EXCHANGE_RATE_MARKUP_PERCENT=0

# Email (transactional: trip-portal magic links + new-booking notifications).
# Choose ONE provider. Leave both blank to disable email (sends are skipped).
#   Option A — Resend (recommended): set the API key only.
#   Option B — SMTP (your domain mailbox): set SMTP_HOST (+ the rest).
# EMAIL_FROM must be a sender you've verified with your provider/domain.
EMAIL_FROM="Goldfinch Adventures <noreply@goldfinch.makutano.co.tz>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Inbox that receives new-booking notifications (blank = skip).
SPECIALIST_EMAIL=

# GA4 Data API (analytics traffic) — service account, backend only. Leave blank
# to run without GA4 (dashboard shows a "not configured" state). Keep the private
# key as one line with literal \n for newlines, wrapped in quotes.
GA4_PROPERTY_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Microsoft Clarity Data Export API — backend only. Bearer token from Clarity →
# Settings → Data export. Powers the real UX-intelligence metrics (rage/dead
# clicks, scroll depth, sessions). Leave blank to show deep-links + onboarding.
# CLARITY_PROJECT_ID is the public id (optional here) used for deep-links.
CLARITY_API_TOKEN=
CLARITY_PROJECT_ID=

# Delete analytics_events older than this many days (nightly job). Default 180.
ANALYTICS_RETENTION_DAYS=180

# ── Goldfinch AI Travel Advisor (v2) ──────────────────────────────────────
AI_ENABLED=true
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=100
AI_MAX_MESSAGES_PER_SESSION=15
AI_MAX_MESSAGES_PER_IP_PER_DAY=30
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=700
AI_USE_PROMPT_CACHING=true
AI_PROMPT_CACHE_TTL=1h
AI_DEGRADE_AT_BUDGET_FRACTION=0.8
ANTHROPIC_SIMPLE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_REASONING_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01
# Semantic layer (pgvector). Dimension must match the vector(N) columns.
AI_EMBEDDING_PROVIDER=          # openai | voyage (leave blank to disable the semantic layer)
AI_EMBEDDING_MODEL=             # e.g. text-embedding-3-small (openai) or voyage-3 (voyage)
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_DIMENSIONS=1536    # must match the vector(N) columns; voyage-3 = 1024
AI_SEMANTIC_CACHE_THRESHOLD=0.92
# Abuse protection (CGNAT-aware) — Turnstile is the primary control.
TURNSTILE_SECRET_KEY=
# ── WhatsApp Business Cloud API ──────────────────────────────────────────────
# APP level: the Meta app itself. Shared by every business account it serves,
# and what the webhook signature is verified against. These stay in the
# environment — they are not any one business's to give.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# Embedded Signup configuration id (Meta app dashboard). Public: the browser
# SDK is given it. Needs Tech Provider status + App Review to be usable.
META_EMBEDDED_SIGNUP_CONFIG_ID=
# ACCOUNT level: the fallback sender, used only until a business connects their
# own WhatsApp Business account from the admin. A connected account wins.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Encrypts credentials this platform stores for a business — currently their
# WhatsApp access token. 32 bytes of hex: openssl rand -hex 32
# Without it, connecting an account is refused outright; nothing is ever
# stored in the clear because this is missing.
CREDENTIALS_ENCRYPTION_KEY=
# Privacy: purge anonymous conversations after N days.
AI_DATA_RETENTION_DAYS=90

# Email delivery switch (true|false). Credentials stay in place when off.
EMAIL_ENABLED=true

# --- Makutano Connect (central WhatsApp/booking infrastructure) -------------
# Server-only. When set, this site acts as a tenant of Makutano Connect.
MAKUTANO_API_URL=https://connect.makutano.co.tz
MAKUTANO_API_KEY=
# 'makutano' routes outbound WhatsApp through Connect (rollback: unset + restart)
WHATSAPP_TRANSPORT=
# 'on' dual-writes public booking enquiries to Connect (fire-and-forget)
MAKUTANO_SYNC_BOOKINGS=
