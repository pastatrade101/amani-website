{
  "name": "amani-website",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.12.0 || >=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace @amani/backend",
    "dev:frontend": "npm run dev --workspace @amani/frontend",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build --workspace @amani/backend",
    "build:frontend": "npm run build --workspace @amani/frontend",
    "check": "npm run check --workspaces --if-present",
    "check:backend": "npm run check --workspace @amani/backend",
    "check:frontend": "npm run check --workspace @amani/frontend",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start:backend",
    "start:backend": "npm run start --workspace @amani/backend",
    "start:frontend": "npm run start --workspace @amani/frontend",
    "preview": "npm run preview --workspace @amani/frontend",
    "test:unit": "npm run test:unit --workspace @amani/backend --",
    "db:pipeline": "npm run db:pipeline --workspace @amani/backend --",
    "db:pipeline:prod": "npm run db:pipeline:prod --workspace @amani/backend --",
    "ai:nightly": "npm run ai:nightly --workspace @amani/backend --",
    "ai:nightly:prod": "npm run ai:nightly:prod --workspace @amani/backend --",
    "backfill:thumbnails": "npm run backfill:thumbnails --workspace @amani/backend --",
    "backfill:thumbnails:prod": "npm run backfill:thumbnails:prod --workspace @amani/backend --",
    "backfill:responsive": "npm run backfill:responsive --workspace @amani/backend --",
    "backfill:responsive:prod": "npm run backfill:responsive:prod --workspace @amani/backend --",
    "media:migrate-r2": "npm run media:migrate-r2 --workspace @amani/backend --",
    "media:migrate-r2:prod": "npm run media:migrate-r2:prod --workspace @amani/backend --",
    "media:downcap": "npm run media:downcap --workspace @amani/backend --",
    "media:downcap:prod": "npm run media:downcap:prod --workspace @amani/backend --",
    "content:prune": "npm run content:prune --workspace @amani/backend --",
    "content:destination-guides": "npm run content:destination-guides --workspace @amani/backend --",
    "content:destination-guides:prod": "npm run content:destination-guides:prod --workspace @amani/backend --",
    "content:safari-style-landing": "npm run content:safari-style-landing --workspace @amani/backend --",
    "content:safari-style-landing:prod": "npm run content:safari-style-landing:prod --workspace @amani/backend --",
    "content:prune:prod": "npm run content:prune:prod --workspace @amani/backend --",
    "email:test": "npm run email:test --workspace @amani/backend --",
    "email:test:prod": "npm run email:test:prod --workspace @amani/backend --",
    "content:lodge-galleries": "npm run content:lodge-galleries --workspace @amani/backend --",
    "test:integration": "npm run test:integration --workspace @amani/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
