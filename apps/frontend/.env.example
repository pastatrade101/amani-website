# Private server-side address of the Express backend, including /api.
# Update this if the backend uses a different port or host.
API_BASE_URL=http://127.0.0.1:5000/api

# For the built Node server, supply HOST, PORT and ORIGIN in the process environment.
# HOST=127.0.0.1
# PORT=3000
# ORIGIN=http://localhost:3000

# Set in the Node process environment to support authenticated CMS media uploads.
# The backend still enforces its per-file limits.
# BODY_SIZE_LIMIT=55M
# Public address of the Cloudflare R2 bucket (or its custom domain). Image URLs
# stored as r2.dev or legacy Supabase-storage addresses are served from here.
# PUBLIC_MEDIA_CDN_URL=https://pub-53959842a05145498927ca5c30795929.r2.dev

# Google Tag Manager / Google tag. Read at runtime: set them in the web
# container's env file and restart it; no rebuild. Empty = no tags at all.
# Tags only run on the live domain, never on /admin, and (in basic mode) only
# after the visitor clicks Accept on the cookie banner.
# PUBLIC_GTM_ID=GTM-XXXXXXX
# A direct GA4 / Google tag (G-… or GT-…). Leave empty when GA4 is set up inside GTM,
# or page views are counted twice.
# PUBLIC_GA4_ID=
# basic (default): load tags after Accept. advanced: load at once, cookieless until Accept.
# PUBLIC_CONSENT_MODE=basic
