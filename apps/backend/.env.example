# Key2africa Safaris - backend environment
# From the repository root: cp apps/backend/.env.example apps/backend/.env
# Fill the values in apps/backend/.env, then run npm run dev:backend.
# This template contains no credentials. Never commit the populated .env file.
# Required for database-backed API features: SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY. Set SUPABASE_DB_URL to run database migrations.
# Replace JWT_SECRET before production. Other integrations below are optional.

# --- Server and website URLs -------------------------------------------------
NODE_ENV=development
PORT=5000
# Website origin used for CORS and generated trip-portal links.
# Use your deployed HTTPS origin in production. CORS accepts comma-separated
# origins, but some link builders use this value as one URL; prefer one origin.
FRONTEND_URL=http://localhost:5174
# Optional public website URL used in quotation links and email branding.
# Set to your deployed website's HTTPS origin in production.
PUBLIC_SITE_URL=http://localhost:5174

# --- Supabase: required for the running API ----------------------------------
# Copy the project URL from Supabase's Connect dialog or project API settings.
# Format: https://YOUR_PROJECT_REF.supabase.co (not a Postgres connection URL).
SUPABASE_URL=
# Backend-only service_role key from Supabase project API Keys settings.
# Do not use an anon/publishable key or the database password here.
# Never put this key in the frontend environment.
SUPABASE_SERVICE_ROLE_KEY=
# Existing public media bucket. Keep this name if using the current bucket;
# change it only to the bucket name configured for your Supabase project.
SUPABASE_STORAGE_BUCKET=goldfinch-media

# --- Direct Postgres connection: database pipeline only ----------------------
# Supabase dashboard -> Connect -> Direct connection -> copy the URI.
# Replace YOUR_DATABASE_PASSWORD with the database password (not an API key).
# Percent-encode reserved characters in the password, e.g. @ becomes %40.
# Format: postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_URL=
# Direct connections need IPv6 unless the project has the IPv4 add-on.
# On IPv4-only hosts, copy the Session pooler URI (port 5432) from Connect into
# SUPABASE_DB_URL. Use its exact host and postgres.PROJECT_REF username.
# Reference: https://supabase.com/docs/guides/database/connecting-to-postgres
# This URL is read only by npm run db:pipeline; it does not replace the two
# Supabase API credentials above. Preview the SQL order without connecting:
#   npm run db:pipeline -- --skip-seed --dry-run
# Apply schema and migrations without inherited sample data or default admins:
#   npm run db:pipeline -- --skip-seed
# Omitting --skip-seed also imports the inherited Goldfinch seed.sql.
# Alternative connection variable names accepted by the pipeline. Leave blank
# when using SUPABASE_DB_URL (precedence: SUPABASE_DB_URL > DATABASE_URL > POSTGRES_URL).
DATABASE_URL=
POSTGRES_URL=
# Optional path to the directory containing schema.sql, migrations/ and seed.sql.
# Blank uses the repository's database/ directory automatically.
DATABASE_DIR=
# false skips seed-demo.sql. --skip-seed suppresses both seed files regardless.
DB_PIPELINE_INCLUDE_DEMO=false
# Blank keeps the pipeline's existing remote TLS behavior. It does not validate
# the remote certificate. localhost automatically skips TLS; "disable" also
# disables it. This script does not implement a verify-full mode switch.
PGSSLMODE=

# --- Authentication ---------------------------------------------------------
# Development-only value. Production refuses this default.
# Generate a replacement locally with: openssl rand -hex 32
# At least 16 characters are required by the backend validator.
JWT_SECRET=development-only-change-this-secret
JWT_EXPIRES_IN=7d

# --- Request limits and public response cache -------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
# 0 disables the in-memory cache; CMS saves invalidate it immediately.
PUBLIC_CACHE_TTL_SECONDS=600

# --- Media storage and processing (optional R2 alternative) ------------------
# false uses Supabase Storage. To enable R2, supply all R2 fields below.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=goldfinch-media
# Public custom domain or r2.dev URL, without a trailing slash.
R2_PUBLIC_URL=
MEDIA_MAX_ORIGINAL_WIDTH=2400
MEDIA_ORIGINAL_QUALITY=82
# Only used by npm run backfill:responsive (maximum media rows per run).
LIMIT=10000

# --- Transactional email (optional: choose Resend OR SMTP) -------------------
# No provider credentials = email sends are skipped.
# false pauses delivery while retaining configured credentials.
EMAIL_ENABLED=true
# Replace example.com with a sender verified by your email provider.
EMAIL_FROM="Key2africa Safaris <noreply@example.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
# Use true with port 465; false with port 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Inbox for new-booking notifications. Blank skips these notifications.
SPECIALIST_EMAIL=

# --- HubSpot CRM (optional) --------------------------------------------------
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# --- Exchange rates (optional: Open Exchange Rates) --------------------------
# Backend-only App ID; never expose it through frontend/public variables.
OPEN_EXCHANGE_RATES_APP_ID=
EXCHANGE_RATE_REFRESH_ENABLED=true
EXCHANGE_RATE_REFRESH_CRON="0 6,18 * * *"
EXCHANGE_RATE_TIMEZONE=Africa/Dar_es_Salaam
EXCHANGE_RATE_CACHE_HOURS=12
EXCHANGE_RATE_MARKUP_PERCENT=0
EXCHANGE_RATE_REQUEST_TIMEOUT_MS=8000
EXCHANGE_RATE_LOCK_TTL_SECONDS=900

# --- Analytics integrations (optional) --------------------------------------
# GA4 Data API service account. All three values are needed for GA4 reporting.
GA4_PROPERTY_ID=
GOOGLE_CLIENT_EMAIL=
# Keep the key double-quoted on one line with literal \n between PEM lines.
GOOGLE_PRIVATE_KEY=
# Microsoft Clarity -> Settings -> Data export.
CLARITY_API_TOKEN=
# Optional public project ID for Clarity dashboard deep-links.
CLARITY_PROJECT_ID=
ANALYTICS_RETENTION_DAYS=180

# --- AI travel advisor and translations (optional) ---------------------------
# ANTHROPIC_API_KEY is also used by the CMS translation provider.
# Leaving it blank disables the Anthropic integration.
ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=100
AI_MAX_MESSAGES_PER_SESSION=15
AI_MAX_MESSAGES_PER_IP_PER_DAY=30
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=700
AI_USE_PROMPT_CACHING=true
AI_PROMPT_CACHE_TTL=1h
AI_DEGRADE_AT_BUDGET_FRACTION=0.8
ANTHROPIC_SIMPLE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_REASONING_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01
# Optional CMS translation model override. Blank uses the provider's code default.
TRANSLATION_MODEL=
# Semantic search/cache: openai or voyage. Blank provider disables this layer.
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_API_KEY=
# Must match both your embedding model output and database vector(N) columns.
AI_EMBEDDING_DIMENSIONS=1536
AI_SEMANTIC_CACHE_THRESHOLD=0.92
# Cloudflare Turnstile secret for AI abuse protection (server-side only).
TURNSTILE_SECRET_KEY=
AI_DATA_RETENTION_DAYS=90

# --- WhatsApp Business Cloud API (optional) ----------------------------------
# App-level values from Meta. Verify token must match your webhook registration.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Fallback sender until a business connects its own account in the admin.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Required to store connected-business credentials. Exactly 64 hex characters:
# openssl rand -hex 32 (generate separately from JWT_SECRET).
# Keep this key stable; existing encrypted tokens need it to be decrypted.
CREDENTIALS_ENCRYPTION_KEY=

# --- Makutano Connect (optional central WhatsApp/booking integration) --------
# Leave blank unless this site is configured as a Connect tenant.
MAKUTANO_API_URL=
MAKUTANO_API_KEY=
# Set to makutano to route outbound WhatsApp through Connect; blank uses Meta.
WHATSAPP_TRANSPORT=
# Set to on to mirror bookings / quotations to Connect; blank leaves sync off.
MAKUTANO_SYNC_BOOKINGS=
MAKUTANO_SYNC_QUOTATIONS=
# Shared signing secret for incoming Connect payment webhooks.
# Without it, the webhook endpoint rejects incoming payment events.
CONNECT_WEBHOOK_SECRET=

# Initial admin provisioning: npm run admin:create --workspace @amani/backend
# Run explicitly; existing accounts and passwords are never overwritten.
# ADMIN_PASSWORD must be at least 16 characters. Keep the real value in .env only.
ADMIN_NAME=Key2africa
ADMIN_EMAIL=admin@key2africa.local
ADMIN_PASSWORD=
